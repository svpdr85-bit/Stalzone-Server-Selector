<Window x:Class="StalzoneServerSelector.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Stalzone Server Selector" Icon="app.ico" Width="1180" Height="740" MinWidth="1110" MinHeight="520"
        Background="#0F1218" WindowStartupLocation="CenterScreen" FontFamily="Segoe UI">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="36" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
  </shell:WindowChrome.WindowChrome>

  <Border x:Name="Root" BorderBrush="#232A38" BorderThickness="1" Background="#0F1218">
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="36"/><RowDefinition Height="*"/></Grid.RowDefinitions>

      <!-- Заголовок окна -->
      <Grid Grid.Row="0" Background="#0B0E13">
        <TextBlock Text="Stalzone Server Selector" Foreground="#7A8499" FontSize="12" VerticalAlignment="Center" Margin="14,0,0,0"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" shell:WindowChrome.IsHitTestVisibleInChrome="True">
          <Button Style="{StaticResource CapBtn}" Content="&#xE921;" Click="Min_Click"/>
          <Button x:Name="MaxBtn" Style="{StaticResource CapBtn}" Content="&#xE922;" Click="Max_Click"/>
          <Button Style="{StaticResource CloseBtn}" Content="&#xE8BB;" Click="Close_Click"/>
        </StackPanel>
      </Grid>

      <Grid Grid.Row="1" Margin="24,16,24,20">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Шапка -->
        <DockPanel Grid.Row="0">
          <Border x:Name="Pill" DockPanel.Dock="Right" CornerRadius="14" Padding="14,6" VerticalAlignment="Center" Background="#232A38">
            <TextBlock x:Name="PillText" Text="Выключено" Foreground="#9AA4B8" FontSize="12" FontWeight="SemiBold"/>
          </Border>
          <Button DockPanel.Dock="Right" Style="{StaticResource Btn}" Content="⚙  Настройки" Margin="0,0,10,0" Click="Settings_Click"/>
          <StackPanel>
            <TextBlock Text="Выбор сервера" Foreground="White" FontSize="26" FontWeight="Bold"/>
            <TextBlock Text="Отметьте серверы, на которые хотите попасть. Остальные будут заблокированы." Foreground="#7A8499" FontSize="12" Margin="0,2,0,0"/>
          </StackPanel>
        </DockPanel>

        <!-- Кнопки -->
        <DockPanel Grid.Row="1" Margin="0,16,0,0">
          <TextBlock x:Name="Stats" DockPanel.Dock="Right" Foreground="#9AA4B8" FontSize="12" VerticalAlignment="Center"/>
          <StackPanel x:Name="Tools" Orientation="Horizontal">
            <Button Style="{StaticResource Btn}" Content="Лучший" Margin="0,0,8,0" Click="Best_Click"/>
            <Button Style="{StaticResource Btn}" Content="Весь регион" Margin="0,0,8,0" Click="AllRegion_Click"/>
            <Button Style="{StaticResource Btn}" Content="Снять все" Margin="0,0,8,0" Click="None_Click"/>
          </StackPanel>
        </DockPanel>

        <!-- Регионы -->
        <ListBox x:Name="PoolList" Grid.Row="2" Background="Transparent" BorderThickness="0" Padding="0" Margin="0,14,0,4"
                 ItemContainerStyle="{StaticResource Chip}" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.VerticalScrollBarVisibility="Disabled" SelectionChanged="PoolList_SelectionChanged">
          <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ListBox.ItemsPanel>
        </ListBox>

        <!-- Таблица -->
        <Border Grid.Row="3" Background="#12161F" CornerRadius="14" Padding="10">
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="14,4,22,8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="36"/><ColumnDefinition Width="72"/><ColumnDefinition Width="*" MinWidth="150"/>
                <ColumnDefinition Width="150"/><ColumnDefinition Width="90"/><ColumnDefinition Width="80"/>
                <ColumnDefinition Width="100"/><ColumnDefinition Width="80"/><ColumnDefinition Width="65"/>
                <ColumnDefinition Width="95"/><ColumnDefinition Width="60"/>
              </Grid.ColumnDefinitions>
              <Button x:Name="HPool" Grid.Column="1" Style="{StaticResource HdrBtn}" Tag="pool" Click="Header_Click"/>
              <Button x:Name="HName" Grid.Column="2" Style="{StaticResource HdrBtn}" Tag="name" Click="Header_Click"/>
              <TextBlock Grid.Column="3" Text="Адрес" Foreground="#7A8499" FontSize="11" FontWeight="SemiBold"/>
              <Button x:Name="HPing" Grid.Column="5" Style="{StaticResource HdrBtn}" Tag="ping" Click="Header_Click"/>
              <TextBlock Grid.Column="6" Text="Мин–Макс" Foreground="#7A8499" FontSize="11" FontWeight="SemiBold"/>
              <Button x:Name="HJitter" Grid.Column="7" Style="{StaticResource HdrBtn}" Tag="jitter" Click="Header_Click"/>
              <Button x:Name="HLoss" Grid.Column="8" Style="{StaticResource HdrBtn}" Tag="loss" Click="Header_Click"/>
              <TextBlock Grid.Column="9" Text="Клиент + Сервер" Foreground="#7A8499" FontSize="11" FontWeight="SemiBold" ToolTip="Пинг до туннеля + пинг туннель→сервер, мс"/>
              <Button x:Name="HScore" Grid.Column="10" Style="{StaticResource HdrBtn}" Tag="score" Click="Header_Click"/>
            </Grid>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Disabled">
              <ItemsControl x:Name="List" IsTabStop="False">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border CornerRadius="10" Margin="0,0,0,6" Padding="14,10" Cursor="Hand" MouseLeftButtonUp="Row_Click">
                      <Border.Style>
                        <Style TargetType="Border">
                          <Setter Property="Background" Value="#171C26"/>
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding Allow}" Value="True"><Setter Property="Background" Value="#1B2A47"/></DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </Border.Style>
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="36"/><ColumnDefinition Width="72"/><ColumnDefinition Width="*" MinWidth="150"/>
                          <ColumnDefinition Width="150"/><ColumnDefinition Width="90"/><ColumnDefinition Width="80"/>
                          <ColumnDefinition Width="100"/><ColumnDefinition Width="80"/><ColumnDefinition Width="65"/>
                          <ColumnDefinition Width="95"/><ColumnDefinition Width="60"/>
                        </Grid.ColumnDefinitions>
                        <CheckBox Grid.Column="0" IsChecked="{Binding Allow, Mode=TwoWay}" VerticalAlignment="Center"/>
                        <Border Grid.Column="1" Background="#232A38" CornerRadius="6" Padding="8,3" Width="58" HorizontalAlignment="Left" VerticalAlignment="Center">
                          <TextBlock Text="{Binding Pool}" Foreground="#9DB8FF" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                        </Border>
                        <TextBlock Grid.Column="2" Text="{Binding Name}" Foreground="White" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Grid.Column="3" Text="{Binding Address}" Foreground="#9AA4B8" FontSize="12" FontFamily="Consolas" VerticalAlignment="Center"/>
                        <ProgressBar Grid.Column="4" Value="{Binding PingBar, Mode=OneWay}" Maximum="100" Height="6" Width="70" HorizontalAlignment="Left" BorderThickness="0"
                                     Background="#232A38" Foreground="{Binding PingBrush}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="5" Text="{Binding PingText}" Foreground="{Binding PingBrush}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" ToolTip="Ожидаемый пинг в игре: до туннеля + туннель→сервер. Для пула MSK2X учитывается только путь до туннеля."/>
                        <TextBlock Grid.Column="6" Text="{Binding MinMaxText}" Foreground="#9AA4B8" FontSize="12" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="7" Text="{Binding JitterText}" Foreground="#9AA4B8" FontSize="12" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="8" Text="{Binding LossText}" Foreground="{Binding LossBrush}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" ToolTip="{Binding LossTip}"/>
                        <TextBlock Grid.Column="9" Text="{Binding PartsText}" ToolTip="{Binding LossTip}" Foreground="#9AA4B8" FontSize="12" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="10" Text="{Binding ScoreText}" Foreground="#7A8499" FontSize="12" VerticalAlignment="Center"/>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Grid>
        </Border>

        <!-- Подвал -->
        <DockPanel Grid.Row="4" Margin="0,14,0,0">
          <Button x:Name="MainBtn" DockPanel.Dock="Right" Style="{StaticResource Btn}" Background="#2FBF71" FontSize="15" FontWeight="Bold"
                  Padding="26,12" Content="▶  Применить" Click="MainBtn_Click"/>
          <TextBlock x:Name="Status" Foreground="#7A8499" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,14,0"/>
        </DockPanel>
      </Grid>

      <!-- Настройки -->
      <Grid x:Name="SettingsOverlay" Grid.Row="1" Visibility="Collapsed" Background="#D90B0E13">
        <Border Background="#171C26" CornerRadius="16" Padding="28" Width="580" VerticalAlignment="Center" HorizontalAlignment="Center"
                BorderBrush="#232A38" BorderThickness="1">
          <StackPanel>
            <TextBlock Text="Настройки" Foreground="White" FontSize="22" FontWeight="Bold"/>
            <TextBlock Text="Фоновая работа и автоматическая блокировка" Foreground="#7A8499" FontSize="12" Margin="0,2,0,20"/>

            <CheckBox x:Name="ChkAutoStart" Style="{StaticResource LabeledCheck}" Content="Запускать вместе с Windows" Click="Setting_Click"/>
            <TextBlock Foreground="#7A8499" FontSize="11" Margin="32,4,0,16" TextWrapping="Wrap"
                       Text="Создаётся задача в Планировщике Windows с правами администратора, поэтому окно запроса UAC при входе не появляется."/>

            <CheckBox x:Name="ChkHidden" Style="{StaticResource LabeledCheck}" Content="При автозапуске скрывать окно (работать в трее)" Click="Setting_Click"/>
            <TextBlock Foreground="#7A8499" FontSize="11" Margin="32,4,0,16" TextWrapping="Wrap"
                       Text="Окно можно открыть двойным щелчком по значку в трее."/>

            <CheckBox x:Name="ChkAutoApply" Style="{StaticResource LabeledCheck}" Content="Включать блокировку автоматически при запуске" Click="Setting_Click"/>
            <TextBlock Foreground="#7A8499" FontSize="11" Margin="32,4,0,16" TextWrapping="Wrap"
                       Text="Используется последний сохранённый выбор серверов: отмеченные разрешены, остальные блокируются."/>

            <CheckBox x:Name="ChkTray" Style="{StaticResource LabeledCheck}" Content="Кнопка закрытия сворачивает программу в трей" Click="Setting_Click"/>
            <TextBlock Foreground="#7A8499" FontSize="11" Margin="32,4,0,20" TextWrapping="Wrap"
                       Text="Полностью выйти можно через значок в трее: правая кнопка, «Выход». При выходе блокировка выключается."/>

            <Button Style="{StaticResource Btn}" Background="#4F8CFF" Content="Готово" HorizontalAlignment="Right" Click="SettingsClose_Click"/>
          </StackPanel>
        </Border>
      </Grid>
    </Grid>
  </Border>
</Window>

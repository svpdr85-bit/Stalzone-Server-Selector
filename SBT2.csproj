<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
    <PublishDir>$(MSBuildProjectDirectory)\dist\</PublishDir>
    <DefaultItemExcludes>$(DefaultItemExcludes);dist\**</DefaultItemExcludes>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>StalzoneServerSelector</AssemblyName>
    <RootNamespace>SBT2</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="lib\WinDivert64.dll" LogicalName="WinDivert64.dll" />
    <EmbeddedResource Include="lib\WinDivert64.sys" LogicalName="WinDivert64.sys" />
    <EmbeddedResource Include="Servers.fallback.json" LogicalName="Servers.fallback.json" />
  </ItemGroup>
</Project>
